# Privileged admin features remain disabled until verified MFA/login rollout.
NODE_ENV=development

# Server-only BFF rollout switch; never enable for public preview builds.
SERVICES_ADMIN_ENABLE_MODERATION_BFF=disabled

# Configure these only through a deployment secret manager when ready:
# SERVICES_ADMIN_COOKIE_KEY=<canonical base64 of 32 cryptographically random bytes>
# SERVICES_BACKEND_INTERNAL_ORIGIN=https://your-trusted-backend.example

# The backend independently requires:
# SERVICES_ENABLE_PLATFORM_MODERATION_HTTP=enabled
# SERVICES_ENABLE_PLATFORM_ADMIN_LOGOUT_HTTP=enabled
# PLATFORM_ADMIN_SESSION_HMAC_KEY=<independent canonical base64 32-byte key>
